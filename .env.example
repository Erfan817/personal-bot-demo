# ═══════════════════════════════════════════════
#  Erifane Bot 配置模板
#  复制成 .env 再填真实值
#  .env 不要提交到 git（已在 .gitignore 里）
# ═══════════════════════════════════════════════

# ── 模型（必填）────────────────────────────────
# 从 platform.deepseek.com 拿，充值 ¥10 够用很久
DEEPSEEK_API_KEY=

# 换模型（不用改代码）—— provider 名来自 pi-ai 的目录
# PROVIDER=deepseek           # 或 moonshotai-cn / zai-coding-cn / openai / anthropic ...
# MODEL=deepseek-flash        # 该 provider 下的模型 id

# ── 渠道 ──────────────────────────────────────
# cli = 命令行（一次性）；feishu = 飞书（长驻）
# 不填默认 cli。用 systemd 跑时在服务单元里设成 feishu。
# CHANNEL=feishu

# ── 飞书（用飞书渠道时必填）────────────────────
# open.feishu.cn → 你的自建应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 准入白名单（强烈建议填）────────────────────
# 逗号分隔的飞书 open_id（ou_ 开头）
# 留空 = 拒绝所有人（安全默认）。发一条消息，日志里会打印你的 open_id。
ALLOWED_USERS=

# ── 调度层（用定时任务时必填）──────────────────
# 定时任务推送到哪个会话。必须是 chat_id（oc_ 开头），不是 open_id（ou_ 开头）。
# 发一条消息，日志里会打印 chat_id。
SCHEDULE_CHAT_ID=

# ── 限频（可选）───────────────────────────────
# RATE_CAPACITY=5            # 令牌桶容量（允许的突发量）
# RATE_REFILL_PER_MIN=10     # 每分钟补充几个

# ── 记忆（可选）───────────────────────────────
# HISTORY_LIMIT=20           # 每次对话带多少条最近消息进上下文
# DB_PATH=./data/memory.db   # SQLite 文件位置

# ── 联网（可选，但推荐）────────────────────────
# 留空时用 DuckDuckGo HTML（免费，但数据中心 IP 可能被人机验证拦）
# 填了就自动切到 Brave Search API（稳定，有免费额度）
# https://brave.com/search/api/
BRAVE_API_KEY=

# ── Agent 调参（可选）─────────────────────────
# MAX_STEPS=5                # 最多几轮工具调用（死循环保护）
# SYSTEM_PROMPT=你是一个简洁、直接的中文助手。

# ── 运维（可选）───────────────────────────────
# HEARTBEAT_FILE=./data/heartbeat
# BACKUP_KEEP=7              # 备份保留几份