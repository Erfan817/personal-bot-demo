# ═══════════════════════════════════════════════════════════
# 备份 —— service（单次执行）
# ═══════════════════════════════════════════════════════════
# 由 erifane-backup.timer 触发。
#
# 以 azureuser 运行：数据库文件属于它，而且备份不需要 root。
# ═══════════════════════════════════════════════════════════

[Unit]
Description=Erifane Bot daily backup

[Service]
Type=oneshot
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/erifane-bot
ExecStart=/usr/bin/node scripts/backup.mjs

# 备份不该跑太久
TimeoutStartSec=300